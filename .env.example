# General
BOT_TOKEN=abc
GUILD_ID=123

# Role names
ADMIN_ROLE=sv{admin}
MANAGER_ROLE=sv{manager}
MODERATOR_ROLE=sv{moderator}
CORE_PLAYER_ROLE=sv{core-player}
KNOWN_PLAYER_ROLE=sv{known-player}
PLAYER_ROLE=sv{player}
MEMBER_ROLE=sv{member}

# Channel IDs (leave one empty to switch off the feature that uses it)
ADMIN_CHANNEL_ID=
CTF_SELECTION_CHANNEL_ID=
UPCOMING_CTFS_CHANNEL_ID=
CALENDAR_CHANNEL_ID=
LEARNING_FORUM_ID=

# Timezone used wherever times are shown or scheduled, and for all-day calendar events
TIMEZONE=Europe/Brussels

# Colors
CTF_ROLE_COLOR_HEX=0x00ff00

# Archive settings
ARCHIVE_LOCAL_PATH=./data/archive/
ARCHIVE_REMOTE_URL=git@github.com:example/archive.git
SHOULD_COMMIT=1
SHOULD_PUSH=1

# Calendar sync (leave ICS_URL empty to switch it off; announcements go to CALENDAR_CHANNEL_ID)
ICS_URL=
# Minutes between syncs, and how many days ahead events are created
ICS_POLL_MINUTES=15
ICS_LOOKAHEAD_DAYS=30
# Role name to mention in announcements (leave empty to ping nobody)
ICS_PING_ROLE=

# Database (SQLite file with all bot state, keep it under ./data so it is persisted)
DATABASE_PATH=./data/stellarhector.db

# Scheduler (minutes without a tick before the watchdog restarts the bot, must be more than 5)
WATCHDOG_TIMEOUT_MINUTES=20

# Debugging settings
LOG_FILE=./data/logs/debug.log
